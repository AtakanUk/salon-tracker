{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:prod": "prisma migrate deploy && node dist/index.js",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/seed.ts",
    "reset-password": "tsx src/tools/reset-password.ts",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^9.0.4",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "@prisma/client": "^6.8.0",
    "archiver": "^5.3.2",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.3.0",
    "nodemailer": "^9.0.3",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^5.3.4",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "embedded-postgres": "17.10.0-beta.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
